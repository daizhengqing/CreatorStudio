{
  "name": "creator-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/runtime.mjs dev",
    "build": "pnpm build:contracts && pnpm --filter @creator-studio/web build && pnpm --filter @creator-studio/server build",
    "typecheck": "pnpm build:contracts && pnpm -r typecheck",
    "start": "node scripts/runtime.mjs start",
    "clean": "node scripts/clean.mjs",
    "doctor": "node scripts/runtime.mjs doctor",
    "setup": "node scripts/runtime.mjs setup",
    "build:contracts": "pnpm --filter @creator-studio/contracts build"
  }
}
