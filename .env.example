# Backend only binds to the local machine. Do not expose it publicly.
HOST=127.0.0.1
PORT=3000
# Optional: default is ~/MediaStudio
# MEDIA_STUDIO_DATA_DIR=/Users/you/MediaStudio
# Optional: yt-dlp and FFmpeg binaries must be available in PATH
# YT_DLP_BIN=yt-dlp
# Optional: use browser cookies for Douyin downloads (edge, chrome, firefox, etc.)
# YT_DLP_COOKIES_BROWSER=edge
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
