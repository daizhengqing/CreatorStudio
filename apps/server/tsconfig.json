{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "types": ["node"], "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
